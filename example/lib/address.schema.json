{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Address",
  "type": "object",
  "properties": {
    "street": { "type": "string" },
    "city": { "type": "string" },
    "zipCode": { "type": "string", "pattern": "^[0-9]{5}$" }
  },
  "required": ["street", "city", "zipCode"]
}
