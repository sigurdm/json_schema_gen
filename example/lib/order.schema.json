{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Order",
  "type": "object",
  "properties": {
    "orderId": { "type": "string" },
    "total": { "type": "number", "minimum": 0 },
    "shippingAddress": { "$ref": "address.schema.json" },
    "billingAddress": { "$ref": "address.schema.json" }
  },
  "required": ["orderId", "total", "shippingAddress"]
}
